{
  "_meta": {
    "title": "Animal Farm Pixel Sprite Workflow (z_image_turbo)",
    "description": "Pixel-art sprite generator using Z-Image Turbo. Renders at 1024x1024 then downscales by 0.0625 to 64x64 with nearest-exact for crisp pixels.",
    "designed_for": "ComfyUI API (POST /prompt). Placeholders {POSITIVE}, {NEGATIVE}, {SEED}, {FILENAME_PREFIX} replaced per item by generate_sprites.py."
  },
  "28": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "30": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2",
      "device": "default"
    }
  },
  "29": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "11": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": ["28", 0],
      "shift": 3
    }
  },
  "13": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "27": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["30", 0],
      "text": "{POSITIVE}"
    }
  },
  "33": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["27", 0]
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{SEED}",
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["11", 0],
      "positive": ["27", 0],
      "negative": ["33", 0],
      "latent_image": ["13", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["29", 0]
    }
  },
  "9": {
    "class_type": "ImageScaleBy",
    "inputs": {
      "image": ["8", 0],
      "upscale_method": "nearest-exact",
      "scale_by": 0.0625
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "{FILENAME_PREFIX}"
    }
  }
}
